# EarlySense backend settings. Copy this file to .env and fill in your own
# values. Never commit .env.

# Django
# SECRET_KEY=change-me-to-a-long-random-string
# DEBUG defaults to False. Set it to True for local development only.
# DEBUG=True
# Comma separated. Default: localhost,127.0.0.1
# ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated. Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Account lockout. Defaults: 5 failed sign-ins, locked for 15 minutes.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# PostgreSQL
# DB_NAME=earlysense_db
# DB_USER=postgres
# DB_PASSWORD=your-database-password
# DB_HOST=localhost
# DB_PORT=5432

# Email (risk alerts)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=EarlySense <you@example.com>

# AI services (script analysis)
# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
# GROQ_MAX_TOKENS=8192
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-3.1-flash-lite
